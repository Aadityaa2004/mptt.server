# ============================================
# Local testing of RPi stack (docker-compose.rpi.yml on dev machine)
# ============================================
# Copy to .env.rpi.local and use with docker-compose.rpi.override.yml
# so routing and CORS use localhost instead of orpheus-networks.com.
# See README or RPI_DEPLOYMENT_STEPS.md: "Testing RPi stack locally"
# ============================================

# Use localhost so the browser talks to nginx on port 80
NEXT_PUBLIC_API_BASE_URL=http://localhost
NEXT_PUBLIC_READINGS_API_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# Rest: copy from env.production.example and fill (DB, JWT, etc.)
# Docker Hub: use your username and tag so other images can be pulled
DOCKERHUB_USERNAME=maplesense
IMAGE_TAG=v1.0.0

DOMAIN=localhost
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot
POSTGRES_SSLMODE=disable

JWT_SECRET_KEY=
INTERNAL_API_SECRET=

ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

BROKER_USER=
BROKER_PASS=
BROKER_TLS=false
BROKER_CA_FILE=

MQTT_TOPIC=sensors/#
MQTT_CLIENT_ID=mqtt-ingestor-prod
MQTT_SHARED_GROUP=

EXTERNAL_BROKER_HOST=
EXTERNAL_BROKER_PORT=1883
EXTERNAL_BROKER_USER=
EXTERNAL_BROKER_PASS=
LOCAL_BROKER_USER=
LOCAL_BROKER_PASS=
TOPIC_FILTER=sensors/#

BATCH_SIZE=200
BATCH_WINDOW=1s
JWT_ACCESS_TOKEN_DURATION=24h
JWT_REFRESH_TOKEN_DURATION=168h
OPENWEATHER_API_KEY=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=MapleSense Alerts
EMAIL_FROM_ADDRESS=
ALERT_COOLDOWN_MINUTES=720
ALERT_RESET_THRESHOLD=70
ALERT_BUCKET_THRESHOLD=75

TZ=Etc/UTC
