# ============================================
# Production Environment Variables Template
# ============================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to git!
# Set permissions: chmod 600 .env.production
# ============================================

# Domain Configuration
DOMAIN=orpheus-networks.com
NEXT_PUBLIC_API_BASE_URL=https://orpheus-networks.com/api
NEXT_PUBLIC_READINGS_API_BASE_URL=https://orpheus-networks.com/api
CORS_ALLOWED_ORIGINS=https://orpheus-networks.com,https://www.orpheus-networks.com

# Docker Hub Configuration
DOCKERHUB_USERNAME=CHANGE_ME

# Database Configuration (PostgreSQL)
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=iot
POSTGRES_SSLMODE=disable

# JWT Authentication Secrets
# Generate a strong random string (64+ characters recommended)
# You can use: openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_RANDOM_SECRET
INTERNAL_API_SECRET=CHANGE_ME_GENERATE_STRONG_RANDOM_SECRET

# Admin Account Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@orpheus-networks.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# MQTT Broker Configuration
BROKER_USER=CHANGE_ME_MQTT_USERNAME
BROKER_PASS=CHANGE_ME_MQTT_PASSWORD
BROKER_TLS=false
BROKER_CA_FILE=

# MQTT Topic Configuration
MQTT_TOPIC=sensors/#
MQTT_CLIENT_ID=mqtt-ingestor-prod
MQTT_SHARED_GROUP=

# External Broker Configuration (if using MQTT Bridge)
EXTERNAL_BROKER_HOST=
EXTERNAL_BROKER_PORT=1883
EXTERNAL_BROKER_USER=
EXTERNAL_BROKER_PASS=

# Local Broker Configuration (for MQTT Bridge)
LOCAL_BROKER_USER=
LOCAL_BROKER_PASS=
TOPIC_FILTER=sensors/#

# Batch Processing Configuration
BATCH_SIZE=200
BATCH_WINDOW=1s

# JWT Token Duration
JWT_ACCESS_TOKEN_DURATION=24h
JWT_REFRESH_TOKEN_DURATION=168h

# External API Keys
OPENWEATHER_API_KEY=

# Timezone
TZ=Etc/UTC
