# ============================================
# Production Environment Variables Template
# ============================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to git!
# Set permissions: chmod 600 .env.production
#
# Docker Compose (${VAR} in docker-compose.rpi.yml): variables are NOT read from
# env_file inside the YAML. Either symlink/copy secrets into `.env`, or run:
#   docker compose --env-file .env.production -f docker-compose.rpi.yml up -d
# ============================================

# Domain Configuration
DOMAIN=orpheus-networks.com
# These base URLs should NOT include `/api` because all frontend
# endpoints already start with `/api/...`.
NEXT_PUBLIC_API_BASE_URL=https://orpheus-networks.com
NEXT_PUBLIC_READINGS_API_BASE_URL=https://orpheus-networks.com
CORS_ALLOWED_ORIGINS=https://orpheus-networks.com,https://www.orpheus-networks.com

# Docker Hub Configuration
DOCKERHUB_USERNAME=maplesense
# Image tag to deploy (must match what you pushed to Docker Hub)
# Example: IMAGE_TAG=v1.0.0
IMAGE_TAG=v1.0.0

# Cloudflare Tunnel Configuration (campus / no-port-forwarding deployments)
# Obtain this from Cloudflare dashboard when you create a tunnel connector.
CLOUDFLARE_TUNNEL_TOKEN=

# Database Configuration (PostgreSQL)
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_password
POSTGRES_DB=iot
POSTGRES_SSLMODE=disable

# JWT Authentication Secrets
# Generate a strong random string (64+ characters recommended)
# You can use: openssl rand -base64 64
JWT_SECRET_KEY=
INTERNAL_API_SECRET=

# Admin Account Configuration
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MQTT Broker Configuration
BROKER_USER=CHANGE_ME_MQTT_USERNAME
BROKER_PASS=CHANGE_ME_MQTT_PASSWORD
BROKER_TLS=false
BROKER_CA_FILE=

# MQTT Topic Configuration
MQTT_TOPIC=sensors/#
MQTT_CLIENT_ID=mqtt-ingestor-prod
MQTT_SHARED_GROUP=

# External Broker Configuration (MQTT Bridge). If empty/unset, the bridge container idles
# (no restart loop) until you set a host. Do not rely on a hard-coded default broker IP.
EXTERNAL_BROKER_HOST=
EXTERNAL_BROKER_PORT=1883
EXTERNAL_BROKER_USER=
EXTERNAL_BROKER_PASS=

# Local Broker Configuration (for MQTT Bridge)
LOCAL_BROKER_USER=
LOCAL_BROKER_PASS=
TOPIC_FILTER=sensors/#

# Batch Processing Configuration
BATCH_SIZE=200
BATCH_WINDOW=1s

# JWT Token Duration
JWT_ACCESS_TOKEN_DURATION=24h
JWT_REFRESH_TOKEN_DURATION=168h

# External API Keys
OPENWEATHER_API_KEY=

# Email (Brevo SMTP) - for MQT EmailService alerts
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME="MapleSense Alerts"
EMAIL_FROM_ADDRESS=
ALERT_COOLDOWN_MINUTES=720
ALERT_RESET_THRESHOLD=70
ALERT_BUCKET_THRESHOLD=75
# Frontend base URL for password reset links in emails (e.g. https://orpheus-networks.com)
FRONTEND_BASE_URL=

# Timezone
TZ=Etc/UTC
